#usda 1.0
(
    defaultPrim = "TrackBarrier"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "TrackBarrier" (
    kind = "component"
    customData = {
        string assetRole = "track-obstacle"
        string authoringTool = "Scripts/build_production_racing_usd.swift"
        string license = "project-original"
        int productionRevision = 2
    }
)
{
    def Scope "Materials"
    {
        def Material "White"
        {
            token outputs:surface.connect = </TrackBarrier/Materials/White/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82000, 0.84000, 0.80000)
                float inputs:metallic = 0.08000
                float inputs:roughness = 0.54000
                token outputs:surface
            }
        }
        def Material "Orange"
        {
            token outputs:surface.connect = </TrackBarrier/Materials/Orange/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96000, 0.24000, 0.02500)
                float inputs:metallic = 0.10000
                float inputs:roughness = 0.42000
                token outputs:surface
            }
        }
        def Material "DarkMetal"
        {
            token outputs:surface.connect = </TrackBarrier/Materials/DarkMetal/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03500, 0.04200, 0.05000)
                float inputs:metallic = 0.86000
                float inputs:roughness = 0.31000
                token outputs:surface
            }
        }
        def Material "Reflector"
        {
            token outputs:surface.connect = </TrackBarrier/Materials/Reflector/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.00000, 0.52000, 0.08000)
                float inputs:metallic = 0.02000
                float inputs:roughness = 0.08000
                color3f inputs:emissiveColor = (1.00000, 0.22000, 0.02000)
                token outputs:surface
            }
        }
    }

    def Cube "dark_base" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 2
        double3 xformOp:translate = (0.00000, 0.08500, 0.00000)
        float3 xformOp:scale = (0.80000, 0.08500, 0.22000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </TrackBarrier/Materials/DarkMetal>
    }
    def Cube "panel_0" (prepend apiSchemas = ["MaterialBindingAPI"])
