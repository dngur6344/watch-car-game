    def Scope "Materials"
    {
        def Material "Paint"
        {
            token outputs:surface.connect = </TrafficSedan/Materials/Paint/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.11000, 0.60000, 0.78000)
