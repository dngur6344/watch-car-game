#usda 1.0
(
    defaultPrim = "AlpineEnvironmentBase"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "AlpineEnvironmentBase"
(
    customData = {
        string authoringTool = "Scripts/build_racing_environment_usd.swift@1.1.0"
        string license = "project-original"
        int revision = 2
        double roadApertureWidth = 14.00000
        double roadClearanceHalfWidth = 6.00000
        string role = "racing-environment-pack"
        string tier = "base"
        string track = "alpine"
    }
)
{
    def Scope "Materials"
    {
        def Material "Terrain"
        {
            token outputs:surface.connect = </AlpineEnvironmentBase/Materials/Terrain/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25000, 0.27000, 0.25000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.92000
                token outputs:surface
            }
        }
        def Material "Rock"
        {
            token outputs:surface.connect = </AlpineEnvironmentBase/Materials/Rock/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.37000, 0.41000, 0.43000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.86000
                token outputs:surface
            }
        }
        def Material "Vegetation"
        {
            token outputs:surface.connect = </AlpineEnvironmentBase/Materials/Vegetation/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10000, 0.24000, 0.18000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.94000
                token outputs:surface
            }
        }
        def Material "Accent"
        {
            token outputs:surface.connect = </AlpineEnvironmentBase/Materials/Accent/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78000, 0.83000, 0.82000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.70000
                token outputs:surface
            }
        }
    }

