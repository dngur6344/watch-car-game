#usda 1.0
(
    defaultPrim = "AlpineEnvironmentEnhanced"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "AlpineEnvironmentEnhanced"
(
    customData = {
        string authoringTool = "Blender 4.5 LTS + Scripts/build_alpine_environment_blender.py@1.0.0"
        string license = "project-original"
        int productionRevision = 3
        int revision = 3
        double roadApertureWidth = 14.00000
        double roadClearanceHalfWidth = 6.00000
        string role = "racing-environment-pack"
        string tier = "enhanced"
        string track = "alpine"
    }
)
{
    def Scope "Materials"
    {
        def Material "Terrain"
        {
            token outputs:surface.connect = </AlpineEnvironmentEnhanced/Materials/Terrain/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.20000, 0.22000, 0.20000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.93000
                token outputs:surface
            }
        }
        def Material "Rock"
        {
            token outputs:surface.connect = </AlpineEnvironmentEnhanced/Materials/Rock/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34000, 0.39000, 0.42000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.84000
                token outputs:surface
            }
        }
        def Material "Vegetation"
        {
            token outputs:surface.connect = </AlpineEnvironmentEnhanced/Materials/Vegetation/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05500, 0.20000, 0.13000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.96000
                token outputs:surface
            }
        }
        def Material "Accent"
        {
            token outputs:surface.connect = </AlpineEnvironmentEnhanced/Materials/Accent/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78000, 0.86000, 0.88000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.68000
                token outputs:surface
            }
        }
    }

