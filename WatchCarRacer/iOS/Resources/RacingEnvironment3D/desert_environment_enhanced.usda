#usda 1.0
(
    defaultPrim = "DesertEnvironmentEnhanced"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "DesertEnvironmentEnhanced"
(
    customData = {
        string authoringTool = "Scripts/build_racing_environment_usd.swift@1.1.0"
        string license = "project-original"
        int revision = 2
        double roadApertureWidth = 14.00000
        double roadClearanceHalfWidth = 6.00000
        string role = "racing-environment-pack"
        string tier = "enhanced"
        string track = "desert"
    }
)
{
    def Scope "Materials"
    {
        def Material "Terrain"
        {
            token outputs:surface.connect = </DesertEnvironmentEnhanced/Materials/Terrain/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55000, 0.27000, 0.13000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.90000
                token outputs:surface
            }
        }
        def Material "Rock"
        {
            token outputs:surface.connect = </DesertEnvironmentEnhanced/Materials/Rock/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.64000, 0.31000, 0.16000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.85000
                token outputs:surface
            }
        }
        def Material "Vegetation"
        {
            token outputs:surface.connect = </DesertEnvironmentEnhanced/Materials/Vegetation/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25000, 0.34000, 0.18000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.95000
                token outputs:surface
            }
        }
        def Material "Accent"
        {
            token outputs:surface.connect = </DesertEnvironmentEnhanced/Materials/Accent/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.77000, 0.49000, 0.21000)
                float inputs:metallic = 0.00000
                float inputs:roughness = 0.81000
                token outputs:surface
            }
        }
    }

